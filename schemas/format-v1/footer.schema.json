{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/null-jones/openspeclib/v0.2.0/schemas/format-v1/footer.schema.json",
  "title": "OpenSpecLib Format v1 file metadata",
  "description": "Schemas for the JSON stored in Parquet footer key-value metadata. Collection files store it under the key `openspeclib`; index files store an index document under the key `openspeclib_index`. Normative.",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "collectionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{1,62}$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX license expression, a 'LicenseRef-' identifier, or 'NOASSERTION'."
    },
    "licenseRef": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "collection": {
      "type": "object",
      "required": [
        "id",
        "title",
        "license",
        "citation",
        "inclusion"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/collectionId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,}/\\S+$"
        },
        "publisher": {
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "license_note": {
          "type": "string"
        },
        "license_refs": {
          "type": "object",
          "description": "Definitions of every 'LicenseRef-' identifier used in this file, keyed by identifier.",
          "propertyNames": {
            "pattern": "^LicenseRef-[A-Za-z0-9.-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/licenseRef"
          }
        },
        "citation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inclusion": {
          "enum": [
            "complete",
            "subset"
          ]
        },
        "inclusion_notes": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "inclusion": {
            "const": "subset"
          }
        }
      },
      "then": {
        "required": [
          "inclusion_notes"
        ]
      }
    },
    "dataset": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,}/\\S+$"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "license_note": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "authors": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "inclusion": {
          "enum": [
            "complete",
            "subset"
          ]
        },
        "inclusion_notes": {
          "type": "string"
        },
        "spectra_available": {
          "type": "integer",
          "minimum": 0
        },
        "spectra_included": {
          "type": "integer",
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "inclusion": {
            "const": "subset"
          }
        },
        "required": [
          "inclusion"
        ]
      },
      "then": {
        "required": [
          "inclusion_notes"
        ]
      }
    },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "material",
          "sample",
          "measurement",
          "bandpass",
          "uncertainty",
          "quality"
        ]
      }
    },
    "collectionFooter": {
      "type": "object",
      "required": [
        "format_version",
        "collection",
        "extensions",
        "created",
        "generator"
      ],
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "$ref": "#/$defs/formatVersion"
        },
        "collection": {
          "$ref": "#/$defs/collection"
        },
        "datasets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/dataset"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9._~-]{1,200}$"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "created": {
          "$ref": "#/$defs/dateTime"
        },
        "generator": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "indexFooter": {
      "type": "object",
      "required": [
        "format_version",
        "created",
        "generator",
        "collections"
      ],
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "$ref": "#/$defs/formatVersion"
        },
        "release": {
          "type": "string",
          "description": "Release version of the distribution this index belongs to, if any."
        },
        "created": {
          "$ref": "#/$defs/dateTime"
        },
        "generator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "num_spectra",
              "metadata"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "num_spectra": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "metadata": {
                "$ref": "#/$defs/collectionFooter"
              }
            }
          }
        }
      }
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/collectionFooter"
    },
    {
      "$ref": "#/$defs/indexFooter"
    }
  ]
}
